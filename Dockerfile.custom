FROM python:3.11-slim
WORKDIR /srv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
RUN pip install --no-cache-dir "numpy>=1.26,<3" "pandas>=2.1,<3" "scipy>=1.11,<2" "scikit-learn>=1.7,<2" "rdkit>=2024.3"
COPY assaylens /srv/assaylens
COPY custom_worker.py /srv/custom_worker.py
